<section class="section">
  <div class="shell">
    <div class="head reveal">
      <span class="eyebrow">How it works</span>
      <h2>From idea to wall in about a week</h2>
    </div>
    <div class="steps reveal">
      <div class="step">
        <h3>Design it</h3>
        <p>Type your text in the customizer, or send us a sketch on WhatsApp.</p>
      </div>
      <div class="step">
        <h3>Approve the proof</h3>
        <p>We send a mockup on your wall colour, free. Changes are unlimited.</p>
      </div>
      <div class="step">
        <h3>We build it</h3>
        <p><span data-ph>3–4 days</span> of hand-bending LED tube onto cut acrylic backing.</p>
      </div>
      <div class="step">
        <h3>It arrives ready</h3>
        <p>Boxed with adaptor, screws and template. Hang it in ten minutes.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom How It Works",
  "presets": [
    {
      "name": "Custom How It Works"
    }
  ]
}
{% endschema %}
