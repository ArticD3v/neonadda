<style>
  .wa-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #25D366;
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(37,211,102,0.3);
    z-index: 1000;
    transition: transform 0.2s;
  }
  .wa-float:hover {
    transform: scale(1.1);
