<footer id="contact">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-col" style="flex: 2; min-width: 250px;">
        <a href="{{ routes.root_url }}" class="logo-img" style="display: inline-flex; align-items: center; margin-bottom: 24px;">
          <img src="{{ 'logo.png' | asset_url }}" alt="Neon Adda" style="height: 40px; width: auto; object-fit: contain;">
        </a>
        <p style="color:var(--muted); font-size:15px; max-width:300px; line-height:1.6; margin-bottom: 24px;">Premium custom neon signs, handcrafted in Hyderabad and shipped all over India.</p>
      </div>
      <div>
        <h5>Shop</h5>
        <ul>
          <li><a href="/#customizer">Customizer</a></li>
          <li><a href="/collections/all">Best sellers</a></li>
          <li><a href="/collections/all">New arrivals</a></li>
          <li><a href="/collections/all">Business logos</a></li>
        </ul>
      </div>
      <div>
        <h5>Company</h5>
        <ul>
          <li><a href="#">About us</a></li>
          <li><a href="/#how">How it works</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">Careers</a></li>
        </ul>
      </div>
      <div>
        <h5>Support</h5>
        <ul>
          <li><a href="#">WhatsApp us</a></li>
          <li><a href="#">Shipping &amp; returns</a></li>
          <li><a href="#">Warranty</a></li>
          <li><a href="#">FAQs</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} Neon Adda. Handmade in Hyderabad.</span>
      <span>Custom Neon Signs · LED Wall Art · Business Logos</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "settings": []
}
{% endschema %}
