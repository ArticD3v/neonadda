<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div>
        <a class="logo" href="/"><span class="logo__neon">NEON</span><span class="logo__adda">adda</span></a>
        <p class="footer__blurb">Hand-made LED neon signs, built to order in <span data-biz-city data-ph>Kolkata</span> and shipped across India.</p>
        <div class="socials">
          <a data-ig href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a data-wa="Hi Neon Adda!" href="#" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a12 12 0 01-5.6-4.9c-.4-.7-.8-1.5-.8-2.3 0-.9.4-1.3.7-1.6.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6a8 8 0 003.7 3.2c.3.1.5.1.6-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.5.2.5.3z"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4>Shop</h4>
        <ul>
          <li><a href="/#customizer">Neon Customizer</a></li>
          <li><a href="/collections/all">All signs</a></li>
          <li><a href="/collections/wedding">Wedding</a></li>
          <li><a href="/collections/birthday">Birthday</a></li>
          <li><a href="/collections/business">Business</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/pages/story">Our Story</a></li>
          <li><a href="/pages/why">Why Neon Adda</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Get in touch</h4>
        <ul>
          <li><a data-wa="Hi Neon Adda!" href="#">WhatsApp <span data-biz-phone data-ph>+91 90000 00000</span></a></li>
          <li><a data-mail href="#"><span data-biz-email data-ph>hello@neonadda.in</span></a></li>
          <li><span style="color:var(--muted-2);font-size:.93rem" data-biz-hours data-ph>Mon–Sat, 10am – 7pm IST</span></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {{ 'now' | date: "%Y" }} Neon Adda. All rights reserved.</span>
      <span>Made to order in India</span>
    </div>
  </div>
</footer>

<a class="wa-float" data-wa="Hi Neon Adda, I'd like to order a custom neon sign." href="#">
  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a12 12 0 01-5.6-4.9c-.4-.7-.8-1.5-.8-2.3 0-.9.4-1.3.7-1.6.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6a8 8 0 003.7 3.2c.3.1.5.1.6-.1l.8-1c.2-.2.3-.2.6-.1l1.8.9c.3.1.5.2.5.3z"/></svg>
  <span>WhatsApp</span>
</a>

