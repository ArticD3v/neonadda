<footer id="contact">
  <div class="wrap">
    <div class="footer-row" style="display: flex; flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 40px; margin-bottom: 50px;">
      
      <div style="flex: 1; min-width: 250px;">
        <a href="{{ routes.root_url }}" class="logo-img" style="display: inline-flex; align-items: center; margin-bottom: 12px;">
          <img src="{{ 'logo.png' | asset_url }}" alt="Neon Adda" style="height: 80px; width: auto; object-fit: contain;">
        </a>
        <p style="color:var(--muted); font-size:14px; max-width:300px; line-height:1.6; margin: 0;">Premium custom neon signs, handcrafted in Hyderabad.</p>
      </div>
      
      <div class="footer-links" style="display: flex; gap: 30px; flex-wrap: wrap; align-items: center;">
        <a href="/#customizer" style="text-decoration:none; color:var(--ivory); font-size:15px; font-weight: 500; opacity: 0.9;">Customizer</a>
        <a href="/collections/all" style="text-decoration:none; color:var(--ivory); font-size:15px; font-weight: 500; opacity: 0.9;">Categories</a>
        <a href="/pages/contact" style="text-decoration:none; color:var(--ivory); font-size:15px; font-weight: 500; opacity: 0.9;">Contact Us</a>
        <a href="https://wa.me/917095844495" target="_blank" style="text-decoration:none; color:var(--cyan); font-size:15px; font-weight: 600;">WhatsApp Us</a>
      </div>
      
    </div>
    
    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} Neon Adda. Handmade in Hyderabad.</span>
      <span>Custom Neon Signs &middot; LED Wall Art &middot; Business Logos</span>
    </div>
  </div>
</footer>

<style>
  .footer-links a:hover {
    color: var(--pink) !important;
    opacity: 1 !important;
  }
  @media (max-width: 768px) {
    .footer-row {
      flex-direction: column !important;
      text-align: center;
    }
    .footer-row > div:first-child {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .footer-links {
      justify-content: center;
      gap: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Footer",
  "settings": []
}
{% endschema %}
