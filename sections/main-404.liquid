<section style="padding: 120px 0; text-align: center; min-height: 60vh; display: flex; align-items: center; justify-content: center; position: relative;">
  <div class="brickwall" style="opacity: 0.3;"></div>
  <div class="wrap" style="position: relative; z-index: 2;">
    <h1 style="font-family: 'Great Vibes', cursive; font-size: 80px; color: var(--pink); text-shadow: 0 0 20px var(--pink); margin: 0 0 20px;">404</h1>
    <h2 style="font-family: var(--heading); font-size: 32px; margin: 0 0 16px;">Lost your glow?</h2>
    <p style="color: var(--muted); max-width: 400px; margin: 0 auto 40px;">The page you're looking for doesn't exist, or maybe it flickered out. Let's get you back on track.</p>
    <a href="/collections/all" class="btn btn-neon">Continue shopping</a>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
