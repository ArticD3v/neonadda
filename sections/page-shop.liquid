<section id="shop" class="animate-on-scroll" style="padding-top:40px;">
  <div class="wrap">
    <div class="section-head" style="max-width:800px; margin:0 auto 40px; text-align:center;">
      <h1 style="font-family:var(--heading);font-weight:700;font-size:clamp(32px,4vw,48px);line-height:1.15;margin-bottom:16px;">Our <span style="color:var(--pink);font-family:var(--display);font-size:1.25em;font-weight:400;">Collection</span></h1>
      <p style="color:var(--muted);font-size:16px;line-height:1.7;">Find the perfect pre-designed neon sign for your space. Handcrafted and shipped to you.</p>
    </div>

    <!-- filters from custom-app.js -->
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:40px; justify-content:center;" id="shopFilters">
      <!-- Generated by JS -->
    </div>

    <div class="cat-grid" id="shopGrid">
      <!-- Generated by JS -->
    </div>
    
    <div style="text-align:center; margin-top:40px; font-family:var(--mono); font-size:12px; color:var(--muted);" id="shopCount">
      Loading...
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Page",
  "settings": [],
  "presets": [
    {
      "name": "Shop Page"
    }
  ]
}
{% endschema %}
