<section style="padding-top:110px;">
  <div class="wrap">
    <div class="section-head" style="margin:0 auto 60px; text-align: center;">
      <div class="eyebrow" style="justify-content: center;">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p style="margin: 0 auto; max-width: 600px;">{{ section.settings.description }}</p>
    </div>

    {% assign shop_collection = collection %}
    {% if shop_collection == blank %}
      {% assign shop_collection = collections[section.settings.collection] %}
      {% if section.settings.collection == blank %}
        {% assign shop_collection = collections.all %}
      {% endif %}
    {% endif %}

    <div class="cat-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
      {% for product in shop_collection.products %}
        <a href="{{ product.url }}" style="text-decoration: none;">
          <div class="cat-card" style="aspect-ratio: 1/1.2; box-shadow: 0 4px 24px rgba(0,0,0,0.4);">
            {% if product.featured_image %}
              <div class="brickwall" style="background-image: url('{{ product.featured_image | img_url: '600x' }}'); background-size: cover; background-position: center; filter: none; opacity: 1;"></div>
              <div class="brickwall" style="opacity: 0.15;"></div>
            {% else %}
              <div class="brickwall"></div>
              <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:'Great Vibes', cursive; font-size:42px; color:var(--pink); text-shadow:0 0 16px var(--pink); z-index:1; padding: 20px; text-align:center;">
                {{ product.title }}
              </div>
            {% endif %}
            
            <div class="catlabel" style="background: linear-gradient(180deg, transparent 0%, rgba(7,7,11,0.9) 100%);">
              <div class="cattag" style="color: var(--cyan);">{{ product.price | money }}</div>
              <h4 style="font-family: var(--heading); font-size: 20px; font-weight: 600; color: var(--ivory); line-height: 1.3;">{{ product.title }}</h4>
            </div>
          </div>
        </a>
      {% else %}
        <div style="grid-column: 1/-1; text-align: center; padding: 60px 0; border: 1px dashed var(--line); border-radius: 18px; color: var(--muted);">
          <p>No products found in this collection.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="final-cta">
      <div class="brickwall"></div>
      <div class="final-cta-inner">
        <div class="eyebrow">Ready when you are</div>
        <h2>Can't find your <span class="accent">vibe?</span></h2>
        <p>Design it on screen right now, or send us a photo of your wall and we'll suggest a size and style.</p>
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a href="/#customizer" class="btn btn-neon">Start designing →</a>
          <a href="#" class="btn btn-ghost">Ask on WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every sign, <span class=\"accent\">ready to customise</span>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "These are our most-ordered designs. Pick one and change the words, colour or size — or start from a blank slate in the customizer."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection to display"
    }
  ],
  "presets": [
    {
      "name": "Premium Shop"
    }
  ]
}
{% endschema %}
