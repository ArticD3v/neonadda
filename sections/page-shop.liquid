<section style="padding-top:110px;">
  <div class="wrap">
    <div class="section-head" style="margin:0 auto 60px; text-align: center;">
      <div class="eyebrow" style="justify-content: center;">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p style="margin: 0 auto; max-width: 600px;">{{ section.settings.description }}</p>
    </div>

    {% assign shop_collection = collection %}
    {% if shop_collection == blank %}
      {% assign shop_collection = collections[section.settings.collection] %}
      {% if section.settings.collection == blank %}
        {% assign shop_collection = collections.all %}
      {% endif %}
    {% endif %}

    <div class="cat-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
      {% for product in shop_collection.products %}
        {% if product.handle == 'custom-neon-sign' %}{% continue %}{% endif %}
        <a href="{{ product.url }}" style="text-decoration: none; display: block;" class="hover-scale-card">
          <div class="glass-panel" style="padding: 0; overflow: hidden; border-radius: 18px; position: relative; aspect-ratio: 1/1.15; display: flex; flex-direction: column; background: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            
            <div style="position: absolute; inset: 0; z-index: 1; overflow: hidden;">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 1 !important; filter: none !important; transition: transform 0.4s ease;" class="product-card-img">
              {% else %}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 32px; background: #0b0c10;">
                  <span style="font-family:'Busted Soul', cursive; color:var(--pink); font-size:42px; text-shadow:0 0 16px var(--pink);">{{ product.title }}</span>
                </div>
              {% endif %}
            </div>
            
            <!-- Subtle bottom gradient only behind text for crisp readability -->
            <div style="position: absolute; inset: auto 0 0 0; height: 45%; background: linear-gradient(to top, rgba(7,7,11,0.95) 0%, rgba(7,7,11,0.6) 50%, transparent 100%); z-index: 2; pointer-events: none;"></div>
            
            <div style="position: relative; z-index: 3; padding: 20px; margin-top: auto;">
              <div style="color: var(--cyan); font-family: var(--mono); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;">{{ product.price | money }}</div>
              <h3 style="font-family: var(--heading); color: var(--ivory); font-size: 20px; font-weight: 600; margin: 0; line-height: 1.3;">{{ product.title }}</h3>
            </div>
            
          </div>
        </a>
      {% else %}
        <div style="grid-column: 1/-1; text-align: center; padding: 60px 0; border: 1px dashed var(--line); border-radius: 18px; color: var(--muted);">
          <p>No products found in this collection.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="final-cta">
      <div class="brickwall"></div>
      <div class="final-cta-inner">
        <div class="eyebrow">Ready when you are</div>
        <h2>Can't find your <span class="accent">vibe?</span></h2>
        <p>Design it on screen right now, or send us a photo of your wall and we'll suggest a size and style.</p>
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a href="/#customizer" class="btn btn-neon">Start designing →</a>
          <a href="https://wa.me/917095844495?text=I'm%20looking%20for%20a%20custom%20neon%20sign" target="_blank" class="btn btn-ghost">Ask on WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hover-scale-card .product-card-img {
    transform: scale(1);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1) !important;
  }
  .hover-scale-card:hover .product-card-img {
    transform: scale(1.06);
  }
  .hover-scale-card .glass-panel {
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .hover-scale-card:hover .glass-panel {
    border-color: rgba(255, 47, 146, 0.5);
    box-shadow: 0 12px 36px rgba(255, 47, 146, 0.2), 0 0 20px rgba(255, 47, 146, 0.1);
    transform: translateY(-4px);
  }
</style>

{% schema %}
{
  "name": "Shop Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop All"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (Use HTML for spans)",
      "default": "Every sign <span class=\"accent\">ready to customise</span>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "These are our most-ordered designs. Pick one and change the words, colour or size — or start from a blank slate in the customizer."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection to display"
    }
  ],
  "presets": [
    {
      "name": "Premium Shop"
    }
  ]
}
{% endschema %}
