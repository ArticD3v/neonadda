<section class="section section--tight">
  <div class="shell">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead" style="max-width:60ch;color:var(--muted)">{{ section.settings.description }}</p>
  </div>
</section>

<section class="section section--tight" style="padding-top:0">
  <div class="shell">
    {% assign shop_collection = collection %}
    {% if shop_collection == blank %}
      {% assign shop_collection = collections[section.settings.collection] %}
      {% if section.settings.collection == blank %}
        {% assign shop_collection = collections.all %}
      {% endif %}
    {% endif %}

    <div class="grid">
      {% for product in shop_collection.products %}
        <a class="card" href="{{ product.url }}">
          <span class="card__art">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" style="width: 100%; border-radius: 8px; object-fit: cover;">
            {% else %}
              <span class="card__sign neon neon--sm" style="--c:#FFC97A;font-family:var(--f-main)">{{ product.title }}</span>
            {% endif %}
          </span>
          <span class="card__meta">
            <span>{{ product.title }}</span>
            <span class="card__price">{{ product.price | money }}</span>
          </span>
        </a>
      {% else %}
        <p style="grid-column: 1/-1; text-align: center; padding: 3rem; color: var(--muted);">No products found in this collection.</p>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="band reveal">
      <h2>Ready to see yours glow?</h2>
      <p>Design it on screen now, or send us a photo of your wall and we'll suggest a size.</p>
      <div class="band__cta">
        <a class="btn btn--primary" href="/#customizer">Design your sign</a>
        <a class="btn btn--wa" data-wa="Hi Neon Adda, I'd like to ask about a custom sign." href="#">Ask on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every sign, ready to customise"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "These are our most-ordered designs. Pick one and change the words, colour or size — or start from a blank slate in the customizer."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection to display"
    }
  ]
}
{% endschema %}
