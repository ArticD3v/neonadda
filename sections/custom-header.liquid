<header>
  <nav class="nav">
    <a href="{{ routes.root_url }}" class="logo">Neon<span>Adda</span></a>
    <div class="navlinks">
      <a href="/#customizer" {% if request.path == '/' %}class="active"{% endif %}>Customizer</a>
      <a href="/collections/all" {% if request.path contains '/collections' or request.path contains '/products' %}class="active"{% endif %}>Shop</a>
      <a href="/#reviews">Reviews</a>
      <a href="/pages/contact" {% if request.path contains '/pages/contact' %}class="active"{% endif %}>Contact</a>
    </div>
    <div class="nav-cart">
      <a href="{{ routes.cart_url }}" class="cart-btn">Cart · {{ cart.total_price | money }}</a>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Custom Header",
  "settings": []
}
{% endschema %}
