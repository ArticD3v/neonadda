<div class="ticker">Free design proof before you pay · Free shipping across India</div>

<header class="header">
  <div class="shell header__bar">
    <a class="logo" href="/" aria-label="Neon Adda home">
      <span class="logo__neon">NEON</span><span class="logo__adda">adda</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        <li class="nav__item"><a class="nav__link" data-page="index.html" href="/">Home</a></li>
        <li class="nav__item nav__item--has-menu" data-open="false">
          <a class="nav__link" href="/pages/story" aria-expanded="false" aria-haspopup="true">
            About Us
            <svg class="nav__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <ul class="submenu">
            <li><a href="/pages/story">Our Story<small>How Neon Adda started</small></a></li>
            <li><a href="/pages/why">Why Neon Adda<small>Materials, warranty, process</small></a></li>
            <li><a href="/pages/faq">FAQ<small>Sizes, delivery, returns</small></a></li>
          </ul>
        </li>
        <li class="nav__item"><a class="nav__link" data-page="shop.html" href="/collections/all">Shop</a></li>
        <li class="nav__item"><a class="nav__link" data-page="customizer.html" href="/#customizer">Neon Customizer</a></li>
        <li class="nav__item"><a class="nav__link" data-page="contact.html" href="/pages/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="header__tools">
      <a class="icon-btn" href="/cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h2l2.5 12h10L20 7H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
        <span class="cart-count" style="display:none">0</span>
      </a>
      <button class="icon-btn icon-btn--menu" id="menuOpen" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false">
  <div class="drawer__top">
    <a class="logo" href="/"><span class="logo__neon">NEON</span><span class="logo__adda">adda</span></a>
    <button class="icon-btn" id="menuClose" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="drawer__body">
    <a class="drawer__link" href="/">Home</a>
    <button class="drawer__link" data-acc="drawerAbout" aria-expanded="false">
      About Us
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="drawer__sub" id="drawerAbout" data-open="false">
      <a href="/pages/story">Our Story</a>
      <a href="/pages/why">Why Neon Adda</a>
      <a href="/pages/faq">FAQ</a>
    </div>
    <a class="drawer__link" href="/collections/all">Shop</a>
    <a class="drawer__link" href="/#customizer">Neon Customizer</a>
    <a class="drawer__link" href="/pages/contact">Contact</a>
    <div class="drawer__cta">
      <a class="btn btn--primary btn--block" href="/#customizer">Design your sign</a>
      <a class="btn btn--wa btn--block" data-wa="Hi Neon Adda, I'd like to order a custom neon sign." href="#">Chat on WhatsApp</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Header",
  "settings": []
}
{% endschema %}
