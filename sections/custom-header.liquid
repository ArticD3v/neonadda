<header class="site-header">
  <nav class="nav">
    <a href="/" class="logo">Neon<span>Adda</span></a>
    <div class="navlinks">
      <a href="/#customizer">Customizer</a>
      <a href="/pages/shop">Shop</a>
      <a href="/pages/story">About Us</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
    </div>
    <div class="nav-cart">
      <a href="/cart" class="cart-btn" id="cart-icon-bubble">Cart · {{ cart.total_price | money_with_currency }}</a>
      <button class="icon-btn icon-btn--menu" id="menuOpen" aria-label="Open menu" aria-expanded="false" aria-controls="drawer" style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ivory)" stroke-width="2" style="width:24px;height:24px;"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </nav>
</header>

<div class="drawer" id="drawer" data-open="false">
  <div class="drawer__top" style="display:flex;justify-content:space-between;padding:20px;border-bottom:1px solid var(--line);">
    <a class="logo" href="/">Neon<span>Adda</span></a>
    <button class="icon-btn" id="menuClose" aria-label="Close menu" style="background:transparent;border:0;color:var(--ivory);">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:24px;height:24px;"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="drawer__body" style="padding:20px;display:flex;flex-direction:column;gap:15px;">
    <a class="drawer__link" href="/" style="color:var(--ivory);text-decoration:none;font-size:18px;font-family:var(--heading);border-bottom:1px solid var(--line);padding-bottom:10px;">Home</a>
    <a class="drawer__link" href="/pages/shop" style="color:var(--ivory);text-decoration:none;font-size:18px;font-family:var(--heading);border-bottom:1px solid var(--line);padding-bottom:10px;">Shop</a>
    <a class="drawer__link" href="/#customizer" style="color:var(--ivory);text-decoration:none;font-size:18px;font-family:var(--heading);border-bottom:1px solid var(--line);padding-bottom:10px;">Customizer</a>
    <a class="drawer__link" href="/pages/story" style="color:var(--ivory);text-decoration:none;font-size:18px;font-family:var(--heading);border-bottom:1px solid var(--line);padding-bottom:10px;">About Us</a>
    <div class="drawer__cta" style="margin-top:20px;display:flex;flex-direction:column;gap:10px;">
      <a class="btn btn-neon" href="/#customizer" style="justify-content:center;">Design your sign</a>
    </div>
  </div>
</div>

<style>
  @media (max-width: 900px) {
    .icon-btn--menu { display: block !important; background: transparent; border: 0; }
    .drawer { position: fixed; inset: 0; background: var(--panel-2); z-index: 1000; transform: translateX(100%); transition: transform 0.3s; }
    .drawer[data-open="true"] { transform: translateX(0); }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuOpen = document.getElementById('menuOpen');
    const menuClose = document.getElementById('menuClose');
    const drawer = document.getElementById('drawer');
    if (menuOpen && drawer) menuOpen.addEventListener('click', () => drawer.setAttribute('data-open', 'true'));
    if (menuClose && drawer) menuClose.addEventListener('click', () => drawer.setAttribute('data-open', 'false'));
  });
</script>

{% schema %}
{
  "name": "Custom Header",
  "settings": []
}
{% endschema %}
