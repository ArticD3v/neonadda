<header style="position: relative;">
  <nav class="nav">
    <button id="mobileNavToggle" class="mobile-toggle" aria-label="Menu" style="display:none; background:none; border:none; color:var(--ivory); cursor:pointer; padding:8px;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    </button>
    <a href="{{ routes.root_url }}" class="logo-img" style="display: flex; align-items: center; margin: -16px 0;">
      <img src="{{ 'logo.png' | asset_url }}" alt="Neon Adda" style="height: 80px; width: auto; object-fit: contain;">
    </a>
    <div class="navlinks" id="desktopNavLinks">
      <a href="/#customizer" {% if request.path == '/' %}class="active"{% endif %}>Customizer</a>
      <a href="/collections/all" {% if request.path contains '/collections' or request.path contains '/products' %}class="active"{% endif %}>Shop</a>
      <a href="/#reviews">Reviews</a>
      <a href="/pages/contact" {% if request.path contains '/pages/contact' %}class="active"{% endif %}>Contact</a>
    </div>
    <div class="nav-cart">
      <a href="{{ routes.cart_url }}" class="cart-btn">Cart · {{ cart.total_price | money }}</a>
    </div>
  </nav>

  <div id="mobileDrawer" style="display:none; flex-direction:column; background:rgba(11, 12, 16, 0.95); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px); position:absolute; top:100%; left:0; width:100%; padding:0 32px 24px; border-bottom:1px solid rgba(255,255,255,0.06); z-index:100;">
      <a href="/#customizer" style="color:var(--ivory); padding:16px 0; text-decoration:none; font-family:var(--heading); font-size:20px; border-bottom:1px solid rgba(255,255,255,0.05);">Customizer</a>
      <a href="/collections/all" style="color:var(--ivory); padding:16px 0; text-decoration:none; font-family:var(--heading); font-size:20px; border-bottom:1px solid rgba(255,255,255,0.05);">Shop</a>
      <a href="/#reviews" style="color:var(--ivory); padding:16px 0; text-decoration:none; font-family:var(--heading); font-size:20px; border-bottom:1px solid rgba(255,255,255,0.05);">Reviews</a>
      <a href="/pages/contact" style="color:var(--ivory); padding:16px 0; text-decoration:none; font-family:var(--heading); font-size:20px;">Contact</a>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('mobileNavToggle');
    const drawer = document.getElementById('mobileDrawer');
    if(toggle && drawer) {
      toggle.addEventListener('click', function() {
        if(drawer.style.display === 'none') {
          drawer.style.display = 'flex';
        } else {
          drawer.style.display = 'none';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Header",
  "settings": []
}
{% endschema %}
