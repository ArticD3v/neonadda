<!-- ================= HERO ================= -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="eyebrow">Handcrafted in India · Est. 2022</div>
      <h1>This isn't lighting.<br><span class="dim">It's</span></h1>
      <div class="script-line accent" style="padding:4px 36px;">branding.</div>
      <p class="lede">Every neon sign we build is bent, wired, and tested by hand in our Hyderabad workshop — then mounted on your wall as a permanent glow-up for your room, cafe, or storefront.</p>
      <div class="hero-actions">
        <a href="#customizer" class="btn btn-neon">Design your sign →</a>
        <a href="#categories" class="btn btn-ghost">Browse the shop</a>
      </div>
      <div class="hero-stats">
        <div><div class="num"><em>10,000+</em> km</div><div class="lbl">Neon flex used</div></div>
        <div><div class="num"><em>3,000+</em></div><div class="lbl">Signs shipped</div></div>
        <div><div class="num"><em>2 yr</em></div><div class="lbl">Warranty</div></div>
      </div>
    </div>
    <div class="hero-art">
      <div class="brickwall"></div>
      <div class="leafshadow"></div>
      <div class="hero-art-content">
        <div class="goodvibes">Good</div>
        <div class="vibes2">Vibes</div>
      </div>
      <div class="plate">Mounted · 18×11 in · Warm Pink</div>
    </div>
  </div>
</section>

<div class="marquee-strip">
  <div class="marquee-track">
    <span>Weddings <em>·</em></span><span>Cafés &amp; Bars <em>·</em></span><span>Home Studios <em>·</em></span><span>Storefronts <em>·</em></span><span>Gaming Rooms <em>·</em></span><span>Birthdays <em>·</em></span><span>Brand Logos <em>·</em></span>
    <span>Weddings <em>·</em></span><span>Cafés &amp; Bars <em>·</em></span><span>Home Studios <em>·</em></span><span>Storefronts <em>·</em></span><span>Gaming Rooms <em>·</em></span><span>Birthdays <em>·</em></span><span>Brand Logos <em>·</em></span>
  </div>
</div>

<!-- ================= CUSTOMIZER ================= -->
<section class="customizer" id="customizer">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Live Neon Customizer</div>
      <h2>Type it. Light it. <span class="accent">See it glow.</span></h2>
      <p>Write your text, pick a font and colour, choose a size — the preview lights up exactly like the sign that lands on your wall.</p>
    </div>

    <div class="customizer-grid">
      <div class="preview-pane">
        <div class="brickwall"></div>
        <div class="preview-stage">
          <div id="neonPreview" class="neon-on" style="font-family:'Great Vibes',cursive; color:#ff2f92;">Good Vibes</div>
        </div>
        <div class="preview-footer">
          <div class="power-toggle" id="powerToggle">
            <span class="power-dot on" id="powerDot"></span>
            <span id="powerLabel">Power on</span>
          </div>
          <div class="mount-hint">Preview updates in real time</div>
        </div>
      </div>

      <div class="controls-pane">
        <h3>Build your sign</h3>
        <p class="sub">This is a working demo of the customizer — plug in your Shopify product variants to make it checkout-ready.</p>

        <div class="field">
          <label>Your text <span class="val" id="charCount">10 / 24</span></label>
          <input type="text" id="textInput" maxlength="24" value="Good Vibes" placeholder="Type your phrase…">
        </div>

        <div class="field">
          <label>Font style <span class="val" id="selectedFontName">Great Vibes</span></label>
          <div class="font-picker-grid" id="fontRow">
            <div class="font-chip active" data-font="'Great Vibes', cursive" data-name="Great Vibes" style="font-family:'Great Vibes', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Great Vibes</span>
            </div>
            <div class="font-chip" data-font="'Alex Brush', cursive" data-name="Alex Brush" style="font-family:'Alex Brush', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Alex Brush</span>
            </div>
            <div class="font-chip" data-font="'Allura', cursive" data-name="Allura" style="font-family:'Allura', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Allura</span>
            </div>
            <div class="font-chip" data-font="'Better Grade', cursive" data-name="Better Grade" style="font-family:'Better Grade', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Better Grade</span>
            </div>
            <div class="font-chip" data-font="'Brittany Signature', cursive" data-name="Brittany Signature" style="font-family:'Brittany Signature', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Brittany</span>
            </div>
            <div class="font-chip" data-font="'Brotherside Signature', cursive" data-name="Brotherside Signature" style="font-family:'Brotherside Signature', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Brotherside</span>
            </div>
            <div class="font-chip" data-font="'Busted Soul', cursive" data-name="Busted Soul" style="font-family:'Busted Soul', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Busted Soul</span>
            </div>
            <div class="font-chip" data-font="'Corinthia', cursive" data-name="Corinthia" style="font-family:'Corinthia', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Corinthia</span>
            </div>
            <div class="font-chip" data-font="'Grayscale Signature', cursive" data-name="Grayscale Signature" style="font-family:'Grayscale Signature', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Grayscale</span>
            </div>
            <div class="font-chip" data-font="'Hamilton Signature', cursive" data-name="Hamilton Signature" style="font-family:'Hamilton Signature', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Hamilton</span>
            </div>
            <div class="font-chip" data-font="'Ink Free', cursive" data-name="Ink Free" style="font-family:'Ink Free', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Ink Free</span>
            </div>
            <div class="font-chip" data-font="'Lavanderia', cursive" data-name="Lavanderia" style="font-family:'Lavanderia', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Lavanderia</span>
            </div>
            <div class="font-chip" data-font="'Lavanderia Delicate', cursive" data-name="Lavanderia Delicate" style="font-family:'Lavanderia Delicate', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Lavanderia Del</span>
            </div>
            <div class="font-chip" data-font="'Lavanderia Sturdy', cursive" data-name="Lavanderia Sturdy" style="font-family:'Lavanderia Sturdy', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Lavanderia Stu</span>
            </div>
            <div class="font-chip" data-font="'Neoneon', sans-serif" data-name="Neoneon" style="font-family:'Neoneon', sans-serif;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Neoneon</span>
            </div>
            <div class="font-chip" data-font="'Ocean Trace', cursive" data-name="Ocean Trace" style="font-family:'Ocean Trace', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Ocean Trace</span>
            </div>
            <div class="font-chip" data-font="'Retake', sans-serif" data-name="Retake" style="font-family:'Retake', sans-serif;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Retake</span>
            </div>
            <div class="font-chip" data-font="'Segoe PR', cursive" data-name="Segoe PR" style="font-family:'Segoe PR', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Segoe PR</span>
            </div>
            <div class="font-chip" data-font="'Story Of Love', cursive" data-name="Story Of Love" style="font-family:'Story Of Love', cursive;">
              <span class="f-sample">Aa</span>
              <span class="f-name">Story Of Love</span>
            </div>
          </div>
        </div>

        <div class="field">
          <label>Glow colour <span class="val" id="colorName">Signal Pink</span></label>
          <div class="swatch-row" id="colorRow" style="display:flex; flex-wrap:wrap; gap:12px;">
            <div class="color-chip glass-chip active" data-color="#ff2f92" data-name="Signal Pink" style="display:flex; align-items:center; gap:10px; padding:10px 18px; border-radius:999px; cursor:pointer;">
              <div class="color-dot" style="width:16px; height:16px; border-radius:50%; background:#ff2f92; box-shadow:0 0 10px #ff2f92;"></div>
              <span class="color-label" style="font-family:var(--heading); font-size:12px; font-weight:500; color:var(--ivory); position:relative; z-index:2;">Signal Pink <span style="color:rgba(255,255,255,0.4); margin-left:6px;">#FF2F92</span></span>
            </div>
            <div class="color-chip glass-chip" data-color="#35f0ff" data-name="Electric Cyan" style="display:flex; align-items:center; gap:10px; padding:10px 18px; border-radius:999px; cursor:pointer;">
              <div class="color-dot" style="width:16px; height:16px; border-radius:50%; background:#35f0ff; box-shadow:0 0 10px #35f0ff;"></div>
              <span class="color-label" style="font-family:var(--heading); font-size:12px; font-weight:500; color:var(--ivory); position:relative; z-index:2;">Electric Cyan <span style="color:rgba(255,255,255,0.4); margin-left:6px;">#35F0FF</span></span>
            </div>
            <div class="color-chip glass-chip" data-color="#b26bff" data-name="Ultraviolet" style="display:flex; align-items:center; gap:10px; padding:10px 18px; border-radius:999px; cursor:pointer;">
              <div class="color-dot" style="width:16px; height:16px; border-radius:50%; background:#b26bff; box-shadow:0 0 10px #b26bff;"></div>
              <span class="color-label" style="font-family:var(--heading); font-size:12px; font-weight:500; color:var(--ivory); position:relative; z-index:2;">Ultraviolet <span style="color:rgba(255,255,255,0.4); margin-left:6px;">#B26BFF</span></span>
            </div>
            <div class="color-chip glass-chip" data-color="#ffb52e" data-name="Amber Glow" style="display:flex; align-items:center; gap:10px; padding:10px 18px; border-radius:999px; cursor:pointer;">
              <div class="color-dot" style="width:16px; height:16px; border-radius:50%; background:#ffb52e; box-shadow:0 0 10px #ffb52e;"></div>
              <span class="color-label" style="font-family:var(--heading); font-size:12px; font-weight:500; color:var(--ivory); position:relative; z-index:2;">Amber Glow <span style="color:rgba(255,255,255,0.4); margin-left:6px;">#FFB52E</span></span>
            </div>
            <div class="color-chip glass-chip" data-color="#3dff8c" data-name="Mint Flash" style="display:flex; align-items:center; gap:10px; padding:10px 18px; border-radius:999px; cursor:pointer;">
              <div class="color-dot" style="width:16px; height:16px; border-radius:50%; background:#3dff8c; box-shadow:0 0 10px #3dff8c;"></div>
              <span class="color-label" style="font-family:var(--heading); font-size:12px; font-weight:500; color:var(--ivory); position:relative; z-index:2;">Mint Flash <span style="color:rgba(255,255,255,0.4); margin-left:6px;">#3DFF8C</span></span>
            </div>
            <div class="color-chip glass-chip" data-color="#ffffff" data-name="Ice White" style="display:flex; align-items:center; gap:10px; padding:10px 18px; border-radius:999px; cursor:pointer;">
              <div class="color-dot" style="width:16px; height:16px; border-radius:50%; background:#ffffff; box-shadow:0 0 10px #ffffff;"></div>
              <span class="color-label" style="font-family:var(--heading); font-size:12px; font-weight:500; color:var(--ivory); position:relative; z-index:2;">Ice White <span style="color:rgba(255,255,255,0.4); margin-left:6px;">#FFFFFF</span></span>
            </div>
          </div>
        </div>

        <div class="field">
          <label>Size</label>
          <div class="size-row" id="sizeRow">
            <div class="size-chip" data-size="42" data-price="2250">
              <div class="s-name">Small</div><div class="s-dim">~10 in · ₹2,250</div>
            </div>
            <div class="size-chip active" data-size="64" data-price="3600">
              <div class="s-name">Medium</div><div class="s-dim">~14 in · ₹3,600</div>
            </div>
            <div class="size-chip" data-size="86" data-price="5350">
              <div class="s-name">Large</div><div class="s-dim">~20 in · ₹5,350</div>
            </div>
          </div>
        </div>

        <div class="field" style="margin-bottom:0;">
          <label>Mounting wall</label>
          <div class="bg-row" id="bgRow">
            <div class="bg-chip active" data-bg="dark">Dark brick</div>
            <div class="bg-chip" data-bg="light">Bare plaster</div>
          </div>
        </div>

        <div class="price-row" style="display: flex; flex-direction: column; gap: 16px;">
          <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <div class="price"><span class="cur">₹</span><span id="priceVal">3,600</span></div>
            <div class="note">Incl. remote control &amp; mounting kit</div>
          </div>
          {% assign current_product = section.settings.customizer_product %}
          {% if current_product == blank %}
            {% for p in collections.all.products limit: 1 %}
              {% assign current_product = p %}
            {% endfor %}
          {% endif %}
          
          <div style="display: flex; gap: 12px; flex-wrap: wrap; width: 100%;" id="customizer-add-buttons">
            {% if current_product != blank %}
              {% assign first_variant_id = current_product.selected_or_first_available_variant.id %}
              <script>
                window.customizerVariants = {
                  {% for variant in current_product.variants %}
                    "{{ variant.title | escape | downcase }}": {{ variant.id }}{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                };
              </script>
              <button type="button" class="btn btn-neon" id="addToCartBtn" data-variant-id="{{ first_variant_id }}" style="flex: 1; min-width: 140px; justify-content: center;">Add to cart</button>
            {% else %}
              <script>window.customizerVariants = {};</script>
              <button type="button" class="btn btn-neon" disabled style="flex: 1; min-width: 140px; justify-content: center;">Add to cart</button>
            {% endif %}
            <a href="#" class="btn btn-ghost" id="whatsappOrderBtn" target="_blank" rel="noopener noreferrer" style="flex: 1; min-width: 140px; justify-content: center;">WhatsApp Order →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section id="how">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Order to Wall</div>
      <h2>Three steps, <span class="accent">one glow</span></h2>
      <p>No showroom visit needed — everything from font choice to final mounting happens through the customizer and a WhatsApp check-in.</p>
    </div>
    <div class="steps">
      <div class="step-card glass-panel">
        <span class="step-idx">01 / DESIGN</span>
        <h4>Build it live</h4>
        <p>Use the customizer above to lock in your text, font, colour and size. What you see is what gets bent into tubing.</p>
        <div class="glowline"></div>
      </div>
      <div class="step-card glass-panel">
        <span class="step-idx">02 / CRAFT</span>
        <h4>Handmade in Hyderabad</h4>
        <p>Our artisans shape LED neon flex to your exact design, mount it on acrylic, and test every sign before it ships.</p>
        <div class="glowline"></div>
      </div>
      <div class="step-card glass-panel">
        <span class="step-idx">03 / INSTALL</span>
        <h4>Mount and switch on</h4>
        <p>Signs arrive pre-drilled with a mounting kit and remote — most customers have it glowing within 15 minutes.</p>
        <div class="glowline"></div>
      </div>
    </div>
  </div>
</section>

<!-- ================= FEATURES ================= -->
<section style="padding-top:0;">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Why Neon Adda</div>
      <h2>Built to <span class="accent">outshine</span> the rest</h2>
    </div>
    <div class="features">
      <div class="feature glass-panel"><div class="ficon">01</div><h4>Un-matched craftsmanship</h4><p>Every sign is hand-bent and finished by artisans who've shaped over 10,000 km of neon flex.</p></div>
      <div class="feature glass-panel"><div class="ficon">02</div><h4>Remote control included</h4><p>Dim it, flash it, or switch colours on multi-tone signs — all from the included remote.</p></div>
      <div class="feature glass-panel"><div class="ficon">03</div><h4>Premium materials</h4><p>High-grade acrylic backing and 2nd-gen LED flex built to stay bright for years, not months.</p></div>
      <div class="feature glass-panel"><div class="ficon">04</div><h4>All-India express delivery</h4><p>Tracked, insured shipping to every pin code, with express options for time-bound events.</p></div>
      <div class="feature glass-panel"><div class="ficon">05</div><h4>True-to-preview colour</h4><p>What glows in the customizer is what glows on your wall — no surprise tints.</p></div>
      <div class="feature glass-panel"><div class="ficon">06</div><h4>Real human support</h4><p>Message us on WhatsApp at any stage — design, order status, or install help.</p></div>
    </div>
  </div>
</section>

<!-- ================= CATEGORIES ================= -->
<section id="categories">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Shop by Mood</div>
      <h2>Find your <span class="accent">glow</span></h2>
    </div>
    <div class="cat-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
      {% assign shop_collection = collections.all %}
      {% for product in shop_collection.products limit: 4 %}
        <a href="{{ product.url }}" style="text-decoration: none;">
          <div class="cat-card glass-panel" style="aspect-ratio: 1/1.2; box-shadow: 0 4px 24px rgba(0,0,0,0.4);">
            {% if product.featured_image %}
              <div class="brickwall" style="background-image: url('{{ product.featured_image | img_url: '600x' }}'); background-size: cover; background-position: center; filter: none; opacity: 1;"></div>
              <div class="brickwall" style="opacity: 0.15;"></div>
            {% else %}
              <div class="brickwall"></div>
              <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:'Great Vibes', cursive; font-size:42px; color:var(--pink); text-shadow:0 0 16px var(--pink); z-index:1; padding: 20px; text-align:center;">
                {{ product.title }}
              </div>
            {% endif %}
            
            <div class="catlabel" style="background: linear-gradient(180deg, transparent 0%, rgba(7,7,11,0.9) 100%);">
              <div class="cattag" style="color: var(--cyan);">{{ product.price | money }}</div>
              <h4 style="font-family: var(--heading); font-size: 20px; font-weight: 600; color: var(--ivory); line-height: 1.3;">{{ product.title }}</h4>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

