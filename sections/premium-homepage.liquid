<!-- ================= SHOP BY CATEGORY ================= -->
<section id="shop-categories" style="position: relative;">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Explore Collections</div>
      <h2>Shop by <span class="accent">Category</span></h2>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
      
      {% assign has_categories = false %}
      {% for block in section.blocks %}
        {% if block.type == 'collection_card' %}
          {% assign has_categories = true %}
          {% assign col = collections[block.settings.collection] %}
          {% assign title = block.settings.title | default: col.title %}
          {% if title == blank %}{% assign title = "Collection" %}{% endif %}
          
          <a href="{{ col.url | default: '/collections/all' }}" style="text-decoration: none;" {{ block.shopify_attributes }}>
            <div class="cat-card glass-panel {{ block.settings.leak_color }}" style="aspect-ratio: 4/3; padding: 32px; display: flex; flex-direction: column; justify-content: flex-end; position: relative; overflow: hidden;">
              <div class="brickwall" style="opacity: 0.3; {% if col.image %}background-image: url('{{ col.image | img_url: '600x' }}'); background-size: cover; background-position: center; filter: none; opacity: 0.75;{% endif %}"></div>
              {% if col.image %}
                <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7,7,11,0) 0%, rgba(7,7,11,0.95) 100%); z-index: 1;"></div>
              {% endif %}
              <div style="position: relative; z-index: 2;">
                <h3 style="color: var(--ivory); font-family: var(--heading); font-size: 32px; margin: 0 0 8px; line-height: 1.1;">{{ title }}</h3>
                <p style="color: var(--muted); margin: 0 0 20px; font-size: 15px;">{{ block.settings.subtitle }}</p>
                <span class="btn btn-ghost" style="padding: 8px 18px; font-size: 13px;">Shop Collection Ã¢â€ â€™</span>
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
      
      {% if has_categories == false %}
        <div style="grid-column: 1/-1; text-align: center; padding: 40px; border: 1px dashed var(--line); border-radius: 12px;">
          <p style="color: var(--muted); margin: 0;">Add Category Cards in the Theme Editor.</p>
        </div>
      {% endif %}

    </div>
  </div>
</section>

<!-- ================= MOST-LOVED SECTION ================= -->
<section class="most-loved" style="padding: 80px 0; background: #fff;">
  <div class="wrap" style="max-width: 1200px; margin: 0 auto; padding: 0 5%;">
    
    <!-- Title with Purple Line -->
    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 40px;">
      <h2 style="font-family: var(--heading); font-size: clamp(28px, 4vw, 36px); font-weight: 700; color: #000; margin: 0; white-space: nowrap;">Most-Loved</h2>
      <div style="height: 3px; background: var(--purple); width: 100%; border-radius: 2px;"></div>
      <div style="display: flex; gap: 10px;">
        <button style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid #ccc; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #000;">&larr;</button>
        <button style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid #000; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #000;">&rarr;</button>
      </div>
    </div>

    <div class="cat-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 24px;">
      {% assign shop_collection = collections.all %}
      {% assign count = 0 %}
      {% for product in shop_collection.products %}
        {% if product.handle == 'custom-neon-sign' %}{% continue %}{% endif %}
        {% if count < 4 %}
          <a href="{{ product.url }}" class="product-card" style="display: block; text-decoration: none; background: #000; border-radius: 12px; overflow: hidden; padding: 16px; display: flex; flex-direction: column; position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            
            <!-- Extra 20% Off Badge -->
            <div style="position: absolute; top: 16px; left: 16px; background: var(--lime); color: #000; font-family: var(--heading); font-size: 10px; font-weight: 800; padding: 4px 8px; z-index: 2;">EXTRA 20% OFF</div>
            
            <!-- Product Image -->
            <div style="width: 100%; aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; margin-bottom: 16px; position: relative; background: #111;">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '600x' }}" style="width: 100%; height: 100%; object-fit: cover;" alt="{{ product.title }}">
              {% else %}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-family:'Busted Soul', cursive; font-size: 32px; color: var(--pink); text-shadow: 0 0 16px var(--pink); text-align: center; padding: 20px;">{{ product.title }}</div>
              {% endif %}
            </div>
            
            <!-- Details -->
            <h4 style="font-family: var(--body); font-size: 15px; font-weight: 600; color: #fff; margin: 0 0 8px; line-height: 1.3;">{{ product.title }} Neon Sign</h4>
            
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
              <span style="font-family: var(--body); font-size: 14px; font-weight: 700; color: #fff;">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span style="font-family: var(--body); font-size: 13px; color: #888; text-decoration: line-through;">{{ product.compare_at_price | money }}</span>
              {% else %}
                <span style="font-family: var(--body); font-size: 13px; color: #888; text-decoration: line-through;">{{ product.price | times: 1.2 | money }}</span>
              {% endif %}
            </div>
            
            <!-- Get it for Badge -->
            <div style="background: rgba(204, 255, 0, 0.1); color: var(--lime); font-family: var(--body); font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; margin-top: auto;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
              Get it for {{ product.price | times: 0.8 | money }}
            </div>
          </a>
          {% assign count = count | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

