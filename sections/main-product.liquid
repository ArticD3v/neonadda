<section style="padding: 100px 0 60px;">
  <div class="wrap">
    <div class="neon-product-grid" style="display: grid !important; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important; gap: 60px !important; align-items: start !important; width: 100% !important;">
      
      <!-- Product Images -->
      <div class="neon-product-media" style="position: sticky; top: 120px; display: block; width: 100%;">
        <div style="border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--panel); position: relative; aspect-ratio: 1/1; width: 100%; display: block;">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 1; display: block;">
          {% else %}
            <div class="brickwall" style="z-index: 0;"></div>
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: 'Great Vibes', cursive; font-size: clamp(32px, 5vw, 64px); color: var(--cyan); text-shadow: 0 0 24px var(--cyan); text-align: center; padding: 40px; line-height: 1.2; z-index: 1;">
              {{ product.title }}
            </div>
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div style="display: flex; gap: 12px; margin-top: 16px; overflow-x: auto; width: 100%;">
            {% for image in product.images %}
              <div style="width: 80px; height: 80px; border-radius: 12px; border: 1px solid var(--line); overflow: hidden; cursor: pointer; flex-shrink: 0;">
                <img src="{{ image | img_url: '200x' }}" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div class="neon-product-info glass-panel" style="padding: 40px; display: block; width: 100%;">
        <div class="eyebrow" style="margin-bottom: 16px; display: inline-flex;">{{ product.type | default: "Premium Neon" }}</div>
        <h1 style="font-family: var(--heading); font-size: 48px; margin: 0 0 16px; line-height: 1.1; display: block;">{{ product.title }}</h1>
        <div style="font-family: var(--mono); font-size: 24px; color: var(--pink); margin-bottom: 32px; letter-spacing: 0.05em; display: block;">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>
        
        <div style="color: var(--muted); font-size: 16px; line-height: 1.7; margin-bottom: 40px; display: block;">
          {{ product.description | default: "Handcrafted LED neon sign built to last. Comes with a free dimmer, mounting kit, and power supply. Shipped securely and ready to plug in." }}
        </div>

        {%- form 'product', product, id: 'product-form-installment', class: 'product-form', style: 'display: block; width: 100%;' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          {% unless product.has_only_default_variant %}
            <div style="margin-bottom: 30px; display: block;">
              {% for option in product.options_with_values %}
                <div class="customizer field" style="margin-bottom: 20px; display: block;">
                  <label style="display: block; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; width: 100%;">{{ option.name }}</label>
                  <select name="options[{{ option.name | escape }}]" class="glass-chip" style="display: block; width: 100%; text-align: left; padding: 13px 16px; font-family: var(--body); font-size: 15px; outline: none; appearance: none;">
                    {% for value in option.values %}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                        {{ value }}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div style="display: grid; gap: 16px; margin-bottom: 32px; grid-template-columns: 1fr;">
            <button type="submit" name="add" class="btn btn-neon" style="width: 100%; justify-content: center; display: inline-flex;" {% if product.available == false %}disabled{% endif %}>
              {% if product.available %}Add to cart{% else %}Sold out{% endif %}
            </button>
            <a href="https://wa.me/919876543210?text=I'm%20interested%20in%20the%20{{ product.title | url_encode }}%20sign" target="_blank" class="btn btn-ghost" style="width: 100%; justify-content: center; border-color: #25D366; color: #25D366; display: inline-flex;">Ask on WhatsApp</a>
          </div>
        {%- endform -%}
        
        <!-- Features List -->
        <ul style="list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); padding-top: 32px; display: block;">
          <li style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px; color: var(--muted); font-size: 14px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2" style="flex-shrink: 0;"><path d="M20 6L9 17l-5-5"/></svg>
            Free dimmer & remote included
          </li>
          <li style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px; color: var(--muted); font-size: 14px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2" style="flex-shrink: 0;"><path d="M20 6L9 17l-5-5"/></svg>
            Ready to mount with included kit
          </li>
          <li style="display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 14px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2" style="flex-shrink: 0;"><path d="M20 6L9 17l-5-5"/></svg>
            24-month premium warranty
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .wrap > div {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    .product-media {
      position: static !important;
    }
  }
</style>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
