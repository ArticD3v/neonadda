<section class="how-it-works animate-on-scroll" id="how">
  <div class="wrap">
    <div class="section-head text-center">
      <div class="eyebrow">The Process</div>
      <h2>From our workshop to <span class="accent">your wall</span></h2>
    </div>
    
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-num">01</div>
        <h4>You design it</h4>
        <p>Use our customizer to pick your phrase, font, and colour. See exactly how it looks before you buy.</p>
      </div>
      <div class="step-card">
        <div class="step-num">02</div>
        <h4>We craft it</h4>
        <p>Our artisans bend the LED flex by hand onto a clear acrylic backboard. Tested for 24 hours.</p>
      </div>
      <div class="step-card">
        <div class="step-num">03</div>
        <h4>You light it up</h4>
        <p>Arrives in 7-10 days with a free mounting kit and remote dimmer. Plug it in and transform your space.</p>
      </div>
    </div>
  </div>
</section>

