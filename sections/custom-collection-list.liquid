<section class="premium-collections-list" style="padding: 120px 0 80px; background: var(--bg);">
  <div class="wrap">
    <div class="section-head text-center" style="margin-bottom: 60px; text-align: center;">
      <div class="eyebrow" style="color:var(--cyan); font-family:var(--mono); text-transform:uppercase; letter-spacing:2px; font-size:12px; margin-bottom:12px;">Explore Categories</div>
      <h1 style="font-family:var(--heading); color:var(--ivory); font-size:clamp(40px, 6vw, 56px); margin:0;">All Collections</h1>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 40px;">
      {% for collection in collections %}
        {% if collection.handle != 'frontpage' %}
          <a href="{{ collection.url }}" style="text-decoration: none; display: block;" class="hover-scale-card">
            <div class="glass-panel leak-top-pink" style="padding: 0; overflow: hidden; border-radius: 16px; position: relative; aspect-ratio: 4/3; display: flex; flex-direction: column;">
              
              <div class="brickwall" style="opacity: 0.2;"></div>
              
              <div style="position: absolute; inset: 0; z-index: 1;">
                {% if collection.image %}
                  <img src="{{ collection.image | img_url: '800x' }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; transition: opacity 0.3s ease;" class="col-img">
                {% else %}
                  <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 32px;">
                    <span style="font-family:'Busted Soul', cursive; color:var(--pink); font-size:48px; text-shadow:0 0 16px var(--pink);">{{ collection.title }}</span>
                  </div>
                {% endif %}
              </div>
              
              <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,7,11,1) 0%, rgba(7,7,11,0.2) 60%, transparent 100%); z-index: 2;"></div>
              
              <div style="position: relative; z-index: 3; padding: 32px; margin-top: auto;">
                <h2 style="font-family: var(--heading); color: var(--ivory); font-size: 28px; font-weight: 600; margin: 0 0 8px 0; line-height: 1.2;">{{ collection.title }}</h2>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                  <span style="color: var(--cyan); font-family: var(--mono); font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">{{ collection.products_count }} Items</span>
                  <span style="color: var(--pink); font-size: 20px;">&rarr;</span>
                </div>
              </div>
              
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .hover-scale-card .col-img {
    transform: scale(1);
    transition: transform 0.5s ease, opacity 0.3s ease !important;
  }
  .hover-scale-card:hover .col-img {
    transform: scale(1.05);
    opacity: 0.8 !important;
  }
  .hover-scale-card .glass-panel {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hover-scale-card:hover .glass-panel {
    border-color: rgba(255, 47, 146, 0.4);
    box-shadow: 0 0 32px rgba(255, 47, 146, 0.15);
  }
</style>

{% schema %}
{
  "name": "Custom Collection List",
  "settings": [],
  "presets": [
    {
      "name": "Custom Collection List"
    }
  ]
}
{% endschema %}
