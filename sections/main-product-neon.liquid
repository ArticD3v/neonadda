<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSK74T+ts+94qhBvVDwcxc=" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
{% assign current_product = product %}
{% if current_product == blank %}
  {% assign current_product = all_products['neon-customizer'] %}
{% endif %}
{% if current_product == blank %}
  {% assign current_product = collections.all.products.first %}
{% endif %}
{% assign default_text = current_product.title | default: "Good Vibes" %}

<section id="customizer" class="customizer animate-on-scroll">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Live Neon Customizer</div>
      <h2>Type it. Light it. <span class="accent">See it glow.</span></h2>
      <p>Write your text, pick a font and colour, choose a size — the preview lights up exactly like the sign that lands on your wall.</p>
    </div>

    <div class="customizer-grid">
      <div class="preview-pane">
        <div class="brickwall"></div>
        <div class="preview-stage">
          <div id="czSign" class="neon-on" style="font-family:var(--display); color:var(--pink); font-size:64px; line-height:1.15; word-break:break-word; max-width:100%; transition:color .25s ease, text-shadow .25s ease, font-family .2s ease, font-size .2s ease;" data-default-text="{{ default_text | escape }}">{{ default_text }}</div>
        </div>
        <div id="czSpill" style="display:none;"></div>
        <div class="preview-footer">
          <div class="power-toggle" id="czPower" aria-pressed="true">
            <span class="power-dot on" id="powerDot"></span>
            <span id="powerLabel">Lit</span>
          </div>
          <div class="mount-hint">Preview updates in real time</div>
        </div>
      </div>

      <div class="controls-pane">
        <h3>Build your sign</h3>
        <p class="sub">This is a working demo of the customizer — plug in your Shopify product variants to make it checkout-ready.</p>

        {% form 'product', current_product, id: 'customizer-form' %}
          <input type="hidden" name="id" id="czVariantId" value="{{ current_product.selected_or_first_available_variant.id }}">
          
          <div class="field">
            <label>Your text <span class="val" id="czCount">{{ default_text.size }} / 24</span></label>
            <input type="text" id="czText" name="properties[Text]" maxlength="24" value="{{ default_text | escape }}" placeholder="Type your phrase…">
          </div>

          <div class="field">
            <label>Font style</label>
            <input type="hidden" id="czFontHidden" name="properties[Font]" value="Script">
            <div class="swatch-row" id="czFonts">
              <div class="opt font-chip active" data-font="script" aria-pressed="true" style="font-family:var(--display);">Aa</div>
              <div class="opt font-chip" data-font="tube" aria-pressed="false" style="font-family:var(--heading);font-weight:700;">Aa</div>
            </div>
          </div>

          <div class="field">
            <label>Glow colour <span class="val" id="czColourName">Warm White</span></label>
            <input type="hidden" id="czColourHidden" name="properties[Color]" value="Warm White">
            <div class="swatch-row" id="czColours"></div>
          </div>

          <div class="field">
            <label>Size <span class="val" id="czSizeName">Medium</span></label>
            <div class="size-row" id="czSizes">
              {% if current_product.has_only_default_variant or current_product == blank %}
                <input type="hidden" id="czSizeHidden" name="properties[Size]" value="Medium">
              {% else %}
                {% for variant in current_product.variants %}
                  <div class="opt size-chip {% if variant.id == current_product.selected_or_first_available_variant.id %}active{% endif %}" data-vid="{{ variant.id }}" data-price="{{ variant.price }}" data-label="{{ variant.title }}" aria-pressed="{% if variant.id == current_product.selected_or_first_available_variant.id %}true{% else %}false{% endif %}">
                    <div class="s-name">{{ variant.title }}</div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <div class="field" style="margin-bottom:0;">
            <label>Mounting wall</label>
            <div class="bg-row" id="bgRow">
              <div class="bg-chip active" data-bg="dark">Dark brick</div>
              <div class="bg-chip" data-bg="light">Bare plaster</div>
            </div>
          </div>

          <div class="price-row">
            <div>
              <div class="price"><span class="cur"></span><span id="czTotal">{{ current_product.selected_or_first_available_variant.price | money }}</span></div>
              <div class="note">Incl. remote control &amp; mounting kit</div>
            </div>
            <button type="submit" name="add" id="czAdd" class="btn btn-neon">Add to cart</button>
          </div>
          
          <a class="btn btn-ghost" style="width:100%; justify-content:center; margin-top: 15px;" data-wa-order href="#">Send this design on WhatsApp</a>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<script>
  window.ShopifyProduct = {
    id: {{ current_product.id | json }},
    price: {{ current_product.selected_or_first_available_variant.price | json }},
    has_variants: {% if current_product.has_only_default_variant or current_product == blank %}false{% else %}true{% endif %}
  };
</script>

{% schema %}
{
  "name": "Neon Customizer",
  "settings": [],
  "presets": [
    {
      "name": "Neon Customizer"
    }
  ]
}
{% endschema %}
