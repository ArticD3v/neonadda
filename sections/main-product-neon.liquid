<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSK74T+ts+94qhBvVDwcxc=" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
{% assign current_product = product %}
{% if current_product == blank %}
  {% assign current_product = all_products['neon-customizer'] %}
{% endif %}
{% if current_product == blank %}
  {% assign current_product = collections.all.products.first %}
{% endif %}

<section class="section section--tight">
  <div class="shell">
    <span class="eyebrow">Neon Customizer</span>
    <h1 id="czHeading">{{ current_product.title | default: "Custom Neon Sign" }}</h1>
    <p class="lead" style="max-width:58ch;color:var(--muted);margin-bottom:2.2rem">
      Type anything up to 24 characters. The preview and the price update as you go — what you see is what we build.
    </p>

    <div class="cz">
      <!-- preview -->
      <div class="cz__preview">
        <div class="cz__stage">
          <div class="board board--bare">
            {% assign default_text = current_product.title | default: "Neon Customizer" %}
            <span class="cz__sign neon" id="czSign" style="--c:#FFC97A" data-default-text="{{ default_text | escape }}">{{ default_text }}</span>
          </div>
        </div>
        <div class="spill" id="czSpill" aria-hidden="true"></div>
        <div style="display:flex;justify-content:center;margin-top:.4rem">
          <button class="toggle" id="czPower" type="button" aria-pressed="true">
            <span class="toggle__track" aria-hidden="true"></span>
            <span>Lit</span>
          </button>
        </div>
      </div>

      <!-- controls -->
      <div class="cz__controls">
        {% form 'product', current_product, id: 'customizer-form' %}
          <input type="hidden" name="id" id="czVariantId" value="{{ current_product.selected_or_first_available_variant.id }}">
          
          <div class="cz__field">
            <label class="cz__label" for="czText">
              <span>Your text</span><b id="czCount">{{ default_text.size }}/24</b>
            </label>
            <input class="input" id="czText" name="properties[Text]" type="text" maxlength="24" value="{{ default_text | escape }}"
                   placeholder="e.g. Happy Birthday" autocomplete="off">
          </div>

          <div class="cz__field">
            <span class="cz__label"><span>Font</span></span>
            <input type="hidden" id="czFontHidden" name="properties[Font]" value="Script">
            <div class="opts" id="czFonts">
              <button class="opt" type="button" data-font="script" aria-pressed="true"
                      style="font-family:var(--script);font-size:1.1rem">Script</button>
              <button class="opt" type="button" data-font="tube" aria-pressed="false"
                      style="font-family:var(--tube);font-size:.85rem">BLOCK</button>
            </div>
          </div>

          <div class="cz__field">
            <span class="cz__label"><span>Tube colour</span><b id="czColourName">Warm White</b></span>
            <input type="hidden" id="czColourHidden" name="properties[Color]" value="Warm White">
            <div class="swatches" id="czColours"></div>
          </div>

          <div class="cz__field">
            <span class="cz__label"><span>Size</span><b id="czSizeName">Medium</b></span>
            <div class="sizes" id="czSizes">
              {% if current_product.has_only_default_variant or current_product == blank %}
                <!-- Fallback to static sizes if product has no variants (dummy mode) -->
                <input type="hidden" id="czSizeHidden" name="properties[Size]" value="Medium">
              {% else %}
                <!-- Real Shopify Variants -->
                {% for variant in current_product.variants %}
                  <button class="opt" type="button" data-vid="{{ variant.id }}" data-price="{{ variant.price }}" data-label="{{ variant.title }}" aria-pressed="{% if variant.id == current_product.selected_or_first_available_variant.id %}true{% else %}false{% endif %}">
                    {{ variant.title }}
                  </button>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <div class="total">
            <div class="total__row">
              <span>Your price, all inclusive</span>
              <span class="total__val" id="czTotal">{{ current_product.selected_or_first_available_variant.price | money }}</span>
            </div>
            <div style="display:grid;gap:.6rem">
              <button class="btn btn--primary btn--block" id="czAdd" type="submit" name="add">Add to cart</button>
              <a class="btn btn--wa btn--block" data-wa-order href="#">Send this design on WhatsApp</a>
            </div>
            <p class="total__note">Free design proof before payment · Free shipping · <span data-ph>2-year warranty</span></p>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<script>
  window.ShopifyProduct = {
    id: {{ current_product.id | json }},
    price: {{ current_product.selected_or_first_available_variant.price | json }},
    has_variants: {% if current_product.has_only_default_variant or current_product == blank %}false{% else %}true{% endif %}
  };
</script>

{% schema %}
{
  "name": "Neon Customizer",
  "settings": []
}
{% endschema %}
