<section class="hero">
  <div class="shell">
    <div class="hero__stage">
      <div class="board">
        <span class="board__holes"></span>
        <span class="hero__line"><span class="hero__sign neon neon--boot" id="heroSign" style="--c:#FFC97A"></span><span class="hero__caret" id="heroCaret" style="--c:#FFC97A" aria-hidden="true"></span></span>
        <span class="cable" aria-hidden="true"></span>
      </div>
      <div class="spill" id="heroSpill" aria-hidden="true"></div>
      <p class="hero__hint">Every sign is cut to your words. Preview it before you pay.</p>
    </div>

    <div class="hero__copy">
      <span class="hero__eyebrow"><i class="hero__dot"></i> Handmade in <span data-biz-city data-ph>Kolkata</span> · Shipped India-wide</span>
      <h1>Say it in light.</h1>
      <p class="hero__lede">Custom LED neon signs for birthdays, weddings, homes and storefronts. Design yours in under a minute, see it glow on screen, and we'll send a free proof before anything is made.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/#customizer">Design your sign</a>
        <a class="btn btn--ghost" href="/collections/all">Browse ready designs</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Hero",
  "presets": [
    {
      "name": "Custom Hero"
    }
  ]
}
{% endschema %}
