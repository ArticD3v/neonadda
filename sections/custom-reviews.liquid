<section class="section section--tight">
  <div class="shell">
    <div class="head reveal">
      <span class="eyebrow">Reviews</span>
      <h2>What customers say</h2>
    </div>
    <div class="reviews reveal">
      <div class="review">
        <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
        <p data-ph>"Ordered a 'Shubh Vivah' sign for my sister's wedding. The proof came the same evening and they changed the font twice without any fuss. Everyone asked where we got it."</p>
        <footer><b data-ph>Ananya R.</b><span data-ph>Wedding · Kolkata</span></footer>
      </div>
      <div class="review">
        <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
        <p data-ph>"We put our café logo in neon above the counter. Two months in, still bright, and it's genuinely brought people in off the street to photograph it."</p>
        <footer><b data-ph>Rohit M.</b><span data-ph>Café owner · Pune</span></footer>
      </div>
      <div class="review">
        <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
        <p data-ph>"Was nervous ordering something this size online. They sent a photo of it lit up in the workshop before packing. Arrived perfectly, mounting kit included."</p>
        <footer><b data-ph>Sneha K.</b><span data-ph>Home decor · Bengaluru</span></footer>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Reviews",
  "presets": [
    {
      "name": "Custom Reviews"
    }
  ]
}
{% endschema %}
