<section id="reviews" class="animate-on-scroll">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">1,000+ Happy Walls</div>
      <h2>What the <span class="accent">Adda</span> hears</h2>
    </div>
    <div class="testi-track">
      <div class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <p>"The customizer showed me exactly what I'd get before I paid a rupee. My café's logo sign matched the preview down to the pink."</p>
        <div class="testi-who"><div class="testi-avatar">R</div><div><div class="testi-name">Rehan K.</div><div class="testi-loc">Café owner, Hyderabad</div></div></div>
      </div>
      <div class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <p>"Ordered a 'Mr &amp; Mrs' sign for our wedding stage. Arrived two days early, mounted itself in minutes with the included kit."</p>
        <div class="testi-who"><div class="testi-avatar">P</div><div><div class="testi-name">Priya S.</div><div class="testi-loc">Bengaluru</div></div></div>
      </div>
      <div class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <p>"Remote lets my kid switch between four colours for her room. Genuinely feels like a premium product, not a knockoff."</p>
        <div class="testi-who"><div class="testi-avatar">A</div><div><div class="testi-name">Anaya M.</div><div class="testi-loc">Mumbai</div></div></div>
      </div>
      <div class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <p>"Support answered on WhatsApp within the hour, twice — once for sizing, once for install questions. Rare these days."</p>
        <div class="testi-who"><div class="testi-avatar">V</div><div><div class="testi-name">Vikram T.</div><div class="testi-loc">Pune</div></div></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Reviews",
  "settings": [],
  "presets": [
    {
      "name": "Custom Reviews"
    }
  ]
}
{% endschema %}
