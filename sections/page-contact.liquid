<section style="padding: 120px 0 80px; min-height: 80vh; display: flex; align-items: center;">
  <div class="wrap" style="max-width: 800px;">
    <div class="section-head" style="text-align: center; margin-bottom: 60px;">
      <div class="eyebrow" style="justify-content: center;">We're here to help</div>
      <h2>Get in <span class="accent">Touch</span></h2>
      <p style="margin: 0 auto; max-width: 500px;">Need help with a custom design, order status, or installation? Send us a message or WhatsApp us directly.</p>
    </div>

    <div class="glass-panel leak-bottom-pink" style="padding: 40px; position: relative; z-index: 1;">
      <div class="brickwall" style="opacity: 0.2;"></div>
      <div style="position: relative; z-index: 2;">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div style="background: rgba(37, 211, 102, 0.1); border: 1px solid #25D366; color: #25D366; padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: center;">
              Thanks for contacting us! We'll get back to you soon.
            </div>
          {% endif %}
          {{ form.errors | default_errors }}
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
            <div class="field">
              <label style="display: block; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px;">Name</label>
              <input type="text" name="contact[name]" id="ContactFormName" class="glass-chip" style="width: 100%; border: 1px solid var(--line); outline: none; color: var(--ivory); padding: 14px 16px; font-family: var(--body); font-size: 15px;" placeholder="Your Name">
            </div>
            <div class="field">
              <label style="display: block; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px;">Email</label>
              <input type="email" name="contact[email]" id="ContactFormEmail" class="glass-chip" style="width: 100%; border: 1px solid var(--line); outline: none; color: var(--ivory); padding: 14px 16px; font-family: var(--body); font-size: 15px;" placeholder="you@example.com">
            </div>
          </div>
          
          <div class="field" style="margin-bottom: 32px;">
            <label style="display: block; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px;">Message</label>
            <textarea rows="5" name="contact[body]" id="ContactFormMessage" class="glass-chip" style="width: 100%; border: 1px solid var(--line); outline: none; color: var(--ivory); padding: 14px 16px; font-family: var(--body); font-size: 15px; resize: vertical;" placeholder="How can we help you?"></textarea>
          </div>
          
          <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
            <button type="submit" class="btn btn-neon" style="flex: 1; justify-content: center; min-width: 200px;">Send Message</button>
            <a href="https://wa.me/919876543210" target="_blank" class="btn btn-ghost" style="flex: 1; justify-content: center; min-width: 200px; border-color: #25D366; color: #25D366;">Chat on WhatsApp</a>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
