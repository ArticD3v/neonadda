<section style="padding: 120px 0 80px; min-height: 80vh; display: flex; align-items: center;">
  <div class="wrap" style="max-width: 1100px;">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 32px;">
      
      <!-- Left Panel: Info -->
      <div class="glass-panel leak-top-blue" style="padding: 50px; display: flex; flex-direction: column; position: relative;">
        <div class="brickwall" style="opacity: 0.1;"></div>
        <div style="position: relative; z-index: 2; display: flex; flex-direction: column; height: 100%;">
          <div class="eyebrow" style="margin-bottom: 16px;">Contact Info Section</div>
          <h2 style="font-family: var(--heading); font-size: 48px; margin: 0 0 16px; line-height: 1.1; color: var(--ivory);">Get in <span class="accent">Touch</span></h2>
          <p style="color: var(--muted); margin: 0 0 40px; font-size: 16px; line-height: 1.6;">We're here to discuss your custom neon sign and bring your ideas to life with premium craftsmanship.</p>

          <div style="display: flex; flex-direction: column; gap: 24px; margin-top: auto;">
            <!-- Email -->
            <div style="display: flex; align-items: center; gap: 16px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <span style="color: var(--ivory); font-size: 15px;">hello@neonadda.com</span>
            </div>
            <!-- Address -->
            <div style="display: flex; align-items: center; gap: 16px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
              <span style="color: var(--ivory); font-size: 15px;">Hyderabad, India</span>
            </div>
            <!-- Phone -->
            <div style="display: flex; align-items: center; gap: 16px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span style="color: var(--ivory); font-size: 15px;">+91 98765 43210</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Panel: Form -->
      <div class="glass-panel leak-bottom-pink" style="padding: 50px; position: relative;">
        <div class="brickwall" style="opacity: 0.1;"></div>
        <div style="position: relative; z-index: 2;">
          <div class="eyebrow" style="margin-bottom: 24px; justify-content: center;">Contact Form</div>
          
          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <div style="background: rgba(37, 211, 102, 0.1); border: 1px solid #25D366; color: #25D366; padding: 16px; border-radius: 8px; margin-bottom: 24px; text-align: center;">
                Thanks for contacting us! We'll get back to you soon.
              </div>
            {% endif %}
            {{ form.errors | default_errors }}
            
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <input type="text" name="contact[name]" class="glass-chip" style="width: 100%; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.05) !important; box-shadow: inset 0 2px 10px rgba(0,0,0,0.2) !important; border-radius: 50px; outline: none; color: var(--ivory); padding: 16px 24px; font-family: var(--body); font-size: 15px;" placeholder="Your Name*">
              
              <input type="email" name="contact[email]" class="glass-chip" style="width: 100%; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.05) !important; box-shadow: inset 0 2px 10px rgba(0,0,0,0.2) !important; border-radius: 50px; outline: none; color: var(--ivory); padding: 16px 24px; font-family: var(--body); font-size: 15px;" placeholder="Email Address*">
              
              <textarea rows="4" name="contact[body]" class="glass-chip" style="width: 100%; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.05) !important; box-shadow: inset 0 2px 10px rgba(0,0,0,0.2) !important; border-radius: 24px; outline: none; color: var(--ivory); padding: 16px 24px; font-family: var(--body); font-size: 15px; resize: vertical;" placeholder="Write your message..."></textarea>
              
              <div style="display: flex; gap: 16px; margin-top: 8px;">
                <button type="submit" class="btn btn-neon" style="flex: 1; justify-content: center; padding: 16px; border-radius: 50px; font-size: 15px;">Send Message</button>
                <a href="https://wa.me/919876543210" target="_blank" class="btn btn-ghost" style="justify-content: center; padding: 16px 24px; border-radius: 50px; border-color: #25D366; color: #25D366;">WhatsApp</a>
              </div>
            </div>
          {% endform %}
        </div>
      </div>
      
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
